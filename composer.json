{
  "name": "toshy/bunnynet-php",
  "description": "BunnyNet API client for PHP",
  "keywords": [
    "Bunny.net",
    "BunnyCDN",
    "BunnyWay",
    "BunnyNet-PHP",
    "BunnyWay-PHP",
    "Bunny PHP",
    "Bunny CDN PHP",
    "BunnyNet PHP client",
    "ToshY"
  ],
  "type": "library",
  "license": "MIT",
  "minimum-stability": "stable",
  "authors": [
    {
      "name": "ToshY",
      "homepage": "https://github.com/ToshY"
    }
  ],
  "autoload": {
    "psr-4": {
      "ToshY\\BunnyNet\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ToshY\\BunnyNet\\Tests\\": "tests/",
      "ToshY\\BunnyNet\\Generator\\": "generator/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "psr/http-client": "^1.0",
    "nyholm/psr7": "^1.6.1"
  },
  "require-dev": {
    "rector/rector": "^2.7",
    "phpmd/phpmd": "^3.0",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^11.5",
    "nette/php-generator": "^4.2",
    "cebe/php-openapi": "^1.8"
  },
  "config": {
  }
}
